# Copia este archivo como .env.local y completa los valores.
# Sin estas variables la app funciona en MODO DEMOSTRACIÓN (datos de prueba en el navegador).

# Supabase → Project Settings → API (solo la clave pública "anon"; NUNCA la service_role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave pública VAPID para notificaciones push (npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Dirección pública del sitio (para enlaces al compartir)
NEXT_PUBLIC_SITE_URL=https://copa-arrayanes.pages.dev
